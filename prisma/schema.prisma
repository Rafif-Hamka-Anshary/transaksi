generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Pelanggan {
  id_pelanggan Int     @id @default(autoincrement())
  nama         String
  email        String  @unique
  telepon      String?
  pesanan      Pesanan[]
}

model Produk {
  id_produk   Int             @id @default(autoincrement())
  nama_produk String
  kategori    String?
  harga       Float
  detail      DetailPesanan[]
}

model Pesanan {
  id_pesanan      Int             @id @default(autoincrement())
  id_pelanggan    Int?
  tanggal_pesanan DateTime        @default(now())
  total_harga     Float           @default(0.00)
  status_pesanan  String          @default("Diproses")
  pelanggan       Pelanggan?      @relation(fields: [id_pelanggan], references: [id_pelanggan])
  detail          DetailPesanan[]
}

model DetailPesanan {
  id_detail   Int     @id @default(autoincrement())
  id_pesanan  Int?
  id_produk   Int?
  jumlah      Int
  subtotal    Float
  pesanan     Pesanan? @relation(fields: [id_pesanan], references: [id_pesanan])
  produk      Produk? @relation(fields: [id_produk], references: [id_produk])
}